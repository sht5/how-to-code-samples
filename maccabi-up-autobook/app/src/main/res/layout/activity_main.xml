<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="12dp"
            android:textIsSelectable="true" />

        <Button
            android:id="@+id/grantPermissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Grant permissions" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Auto-book every week" />

        <EditText
            android:id="@+id/idNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="ID number (stored encrypted; leave empty to keep)"
            android:inputType="numberPassword" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="Class day" />

        <Spinner
            android:id="@+id/classDay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/classTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Class time (HH:mm)"
            android:inputType="time" />

        <EditText
            android:id="@+id/backupTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Backup class time if full (optional)"
            android:inputType="time" />

        <EditText
            android:id="@+id/activityKeyword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Activity name contains" />

        <EditText
            android:id="@+id/studioKeyword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Studio name contains" />

        <EditText
            android:id="@+id/opensDaysBefore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Booking opens N days before the class"
            android:inputType="number" />

        <EditText
            android:id="@+id/opensAt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Booking opens at (HH:mm)"
            android:inputType="time" />

        <EditText
            android:id="@+id/smsKeyword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Login SMS contains (sender or text)" />

        <Button
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save and schedule" />

        <Button
            android:id="@+id/dryRun"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dry run now" />

        <Button
            android:id="@+id/skipNext"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Skip next class" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="Log (newest first)"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
